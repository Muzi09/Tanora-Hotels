  "about": {
    "title": "About",
    "sections": {
      "heroBanner": {
        "title": "Hero Banner",
        "content": {
          "image": "/images/hero_hotel_1784569172973.png",
          "alt": "Tanora Hotel",
          "heading": "About Tanora Hotel"
        }
      },
      "hotelStory": {
        "title": "Hotel Story",
        "content": {
          "heading": "Hotel Story",
          "heading2": "Welcome to Tanora Hotel",
          "description": "Nestled in the vibrant heart of Indore, Tanora Hotel is a premium 3-star property that offers more than just a place to stay. It is a sanctuary of comfort, elegance, and genuine hospitality. From the moment you arrive, our dedication to creating unforgettable experiences ensures that your time with us is nothing short of exceptional.",
          "description2": "At Tanora, we perfectly blend modern convenience with timeless charm. As a proud 3-star hotel, our thoughtfully designed rooms and suites offer a peaceful retreat from the city's hustle and bustle. Whether you are winding down after a busy day of business or exploring Indore’s rich culture, our attentive staff is committed to anticipating your needs with personalized, warm service."
        }
      },
      "whyChooseTanora": {
        "title": "Why Choose Tanora",
        "content": {
          "heading": "Why Choose Tanora",
          "items": [
            {
              "title": "Elegant 3-Star Accommodation",
              "desc": "Beautifully appointed rooms equipped with modern amenities.",
              "icon": "bedroom_parent"
            },
            {
              "title": "Delightful Dining",
              "desc": "Curated culinary experiences featuring local and international cuisine.",
              "icon": "restaurant"
            },
            {
              "title": "Hospitality from the Heart",
              "desc": "Exceptional round-the-clock service.",
              "icon": "favorite"
            },
            {
              "title": "An Oasis of Calm",
              "desc": "Peaceful atmosphere for complete relaxation.",
              "icon": "spa"
            }
          ]
        }
      },
      "missionVision": {
        "title": "Mission & Vision",
        "content": {
          "icon": "flag",
          "heading": "Our Mission",
          "description": "At Tanora Hotel, our mission is to deliver comfortable, modern, and affordable stays with genuine hospitality. We are committed to providing clean, well-equipped rooms and friendly service that makes every guest feel welcome and cared for, ensuring a pleasant and hassle-free experience from check-in to check-out.",
          "icon2": "visibility",
          "heading2": "Our Vision",
          "description2": "Our vision is to become the preferred choice for travelers in Indore by building a reputation as a reliable, new-generation hotel that prioritizes guest comfort, value, and satisfaction. We aim to create memorable stays that inspire guests to return again and again."
        }
      },
